rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Checks if the user is signed in to Firebase Authentication
    function isSignedIn() {
      return request.auth != null;
    }

    // Checks if the signed-in user is a Master Admin
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "dexgamer277@gmail.com" || 
        request.auth.token.email == "admin@menuflow.com" ||
        request.auth.token.email == "saimonsantosofficial@gmail.com" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin")
      );
    }

    // Checks if the authenticated user is an active waiter of a given restaurant
    function isWaiterOf(restaurantId) {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/waiters/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/waiters/$(request.auth.uid)).data.restaurantId == restaurantId &&
        get(/databases/$(database)/documents/waiters/$(request.auth.uid)).data.isActive == true;
    }

    // Rules for Users
    match /users/{uid} {
      allow read, write: if (isSignedIn() && request.auth.uid == uid) || isAdmin();
    }

    // Rules for Restaurants
    match /restaurants/{restaurantId} {
      allow read: if true; // Public for menu access and listing
      allow write: if isAdmin() || (isSignedIn() && restaurantId == request.auth.uid);
    }

    // Rules for Products
    match /products/{productId} {
      allow read: if true; // Public so clients can view products
      allow write: if true; // Allow public write for stock updates during checkout
    }

    // Rules for Categories
    match /categories/{categoryId} {
      allow read: if true; // Public so clients can view categories
      allow write: if true; // Public for updates
    }

    // Rules for Configs
    match /configs/{configId} {
      allow read: if true;
      allow write: if isAdmin(); // Only master admins can edit config documents
    }

    // Rules for Plans
    match /plans/{planId} {
      allow read: if true;
      allow write: if isAdmin(); // Only master admins can edit plan configs
    }

    // Rules for Subscriptions
    match /subscriptions/{subscriptionId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn(); // Allow payment integration updates
    }

    // Rules for Orders
    match /orders/{orderId} {
      // Required to be open so anonymous customers can place orders
      allow create: if true;
      // Allow the user to read/update the order if they are an admin OR if the order belongs to their restaurant or active waiter
      allow read, update, delete: if isAdmin() || (isSignedIn() && (resource == null || resource.data.restaurantId == request.auth.uid || isWaiterOf(resource.data.restaurantId)));
    }

    // Rules for Tables
    match /tables/{tableId} {
      allow read: if true; // Public so clients can view tables if needed, or customers can see status
      allow write: if isAdmin() || (isSignedIn() && (resource == null || request.resource.data.restaurantId == request.auth.uid || resource.data.restaurantId == request.auth.uid || isWaiterOf(resource != null ? resource.data.restaurantId : request.resource.data.restaurantId)));
    }

    // Rules for Menu Views (Analytics)
    match /menu_views/{viewId} {
      allow create: if true; // Public analytics collection on menu visit
      allow read, update, delete: if isAdmin() || (isSignedIn() && (resource == null || resource.data.restaurantId == request.auth.uid));
    }

    // Rules for Announcements/Avisos
    match /announcements/{announcementId} {
      allow read: if true; // Public so clients can view announcements in the menu
      allow write: if isAdmin() || (isSignedIn() && (resource == null || request.resource.data.restaurantId == request.auth.uid || resource.data.restaurantId == request.auth.uid));
    }

    // Rules for Waiters
    match /waiters/{waiterId} {
      allow read: if true; // Public so client can resolve and view active list for order taking if needs be
      allow write: if isAdmin() || (isSignedIn() && (resource == null || request.resource.data.restaurantId == request.auth.uid || resource.data.restaurantId == request.auth.uid));
    }

    // Rules for Frames (Molduras)
    match /frames/{frameId} {
      allow read: if true; // Public so all restaurants and clients can view the frames
      allow write: if isAdmin(); // Only super admins can manage the frames
    }

    // Rules for Promotions
    match /promotions/{promotionId} {
      allow read: if true; // Public so clients can see active promotions on the menu
      allow write: if isAdmin() || (isSignedIn() && (resource == null || request.resource.data.restaurantId == request.auth.uid || resource.data.restaurantId == request.auth.uid));
    }

    // Rules for Subscription Payments
    match /subscription_payments/{paymentId} {
      allow read: if isSignedIn() && (isAdmin() || resource == null || resource.data.restaurantId == request.auth.uid);
      allow write: if isAdmin() || (isSignedIn() && (resource == null || request.resource.data.restaurantId == request.auth.uid || resource.data.restaurantId == request.auth.uid));
    }

    // Rules for SuperAdmin Logs
    match /superadmin_logs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
